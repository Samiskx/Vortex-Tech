# Chave oficial da API do Google Gemini (obter no Google AI Studio)
GEMINI_API_KEY=

# Modelo usado pelo chatbot.
# gemini-3.5-flash-lite = leve, rápido e com cota gratuita maior (recomendado).
# Para respostas mais elaboradas, troque o valor de GEMINI_MODEL.
GEMINI_MODEL=gemini-3.5-flash-lite

# Porta do servidor
PORT=3000

# Banco de dados PostgreSQL (local ou nuvem como Neon/Supabase)
# A senha foi definida quando você instalou o PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=suasenha
DB_NAME=vortex_tech
