# Chave da API do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo usado pelo chatbot.
# gemini-3.5-flash-lite = leve, rápido e com cota gratuita maior (recomendado).
# Para respostas mais elaboradas, use gemini-3.8-flash (consome a cota mais rápido).
GEMINI_MODEL=gemini-3.5-flash-lite

# Porta do servidor
PORT=3000

# Limites de uso do chat (protegem a cota gratuita da API)
CHAT_RPM=10
CHAT_RPD=150

# Banco de dados PostgreSQL
# A senha foi definida quando voce instalou o PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_a_senha_do_postgres_aqui
DB_NAME=vortex_tech
